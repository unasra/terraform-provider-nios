// ── Parameters ────────────────────────────────────────────────────────────────
properties([
    parameters([
        string(name: 'GM_URL',     defaultValue: 'https://host-a.infoblox.com', description: 'URL For the GRID Master'),
        string(name: 'MEMBER_URL', defaultValue: 'https://host-b.infoblox.com', description: 'URL for the GRID Member'),
        string(name: 'DISCOVERY_MEMBER_URL', defaultValue: '', description: 'URL for the Discovery GRID Member'),
        string(name: 'TF_VERSION', defaultValue: '1.14.1',                       description: 'Terraform version to install e.g. 1.8.0'),
        string(name: 'REPO_USER',  defaultValue: 'infobloxopen',                      description: 'GitHub repository owner/user (for using forks)'),
        string(name: 'BRANCH',     defaultValue: 'main',                  description: 'Branch name to checkout'),
        booleanParam(name: 'ENABLE_DEBUG_LOGGING', defaultValue: false,   description: 'Enable DEBUG level Terraform logging (TF_LOG=DEBUG)'),
        booleanParam(name: 'RUN_SET_LICENSE',      defaultValue: false,   description: 'Set Licenses on Grids before tests'),

        // ── Test-group selection (all enabled by default) ─────────────────
        booleanParam(name: 'RUN_ACL',             defaultValue: true, description: 'Run ACL tests'),
        booleanParam(name: 'RUN_CLOUD',           defaultValue: true, description: 'Run Cloud tests'),
        booleanParam(name: 'RUN_DHCP',            defaultValue: true, description: 'Run DHCP tests'),
        booleanParam(name: 'RUN_DISCOVERY',       defaultValue: true, description: 'Run Discovery tests'),
        booleanParam(name: 'RUN_DNS',             defaultValue: true, description: 'Run DNS tests'),
        booleanParam(name: 'RUN_DTC',             defaultValue: true, description: 'Run DTC tests'),
        booleanParam(name: 'RUN_GRID',            defaultValue: true, description: 'Run Grid tests'),
        booleanParam(name: 'RUN_IPAM',            defaultValue: true, description: 'Run IPAM tests'),
        booleanParam(name: 'RUN_MICROSOFT',       defaultValue: true, description: 'Run Microsoft tests'),
        booleanParam(name: 'RUN_MISC',            defaultValue: true, description: 'Run Misc tests'),
        booleanParam(name: 'RUN_NOTIFICATION',    defaultValue: true, description: 'Run Notification tests'),
        booleanParam(name: 'RUN_PARENTALCONTROL', defaultValue: true, description: 'Run Parental Control tests'),
        booleanParam(name: 'RUN_RIR',             defaultValue: true, description: 'Run RIR tests'),
        booleanParam(name: 'RUN_RPZ',             defaultValue: true, description: 'Run RPZ tests'),
        booleanParam(name: 'RUN_SECURITY',        defaultValue: true, description: 'Run Security tests'),
        booleanParam(name: 'RUN_SMARTFOLDER',     defaultValue: true, description: 'Run Smart Folder tests')
    ])
])

def runTestStage(String name, String dir, String timeout) {
    stage("Tests: ${name}") {
        try {
            sh """
                cd ${dir}
                go test -v -count=1 -timeout ${timeout} ./... \
                    2>&1 | tee \$WORKSPACE/test-results/${name}.txt
            """
        } catch (err) {
            echo "Tests in ${dir} failed: ${err}"
            currentBuild.result = 'FAILURE'
        } finally {
            sh "go-junit-report < \$WORKSPACE/test-results/${name}.txt > \$WORKSPACE/test-results/${name}-junit.xml || true"
        }
    }
}

def sendTestResultsMail(Map args) {
    def buildStatus  = args.buildStatus ?: 'SUCCESS'

    // Parse JUnit XML files directly — sandbox-safe (no currentBuild.testResultAction)
    def counts = sh(
        script: '''python3 - <<'EOF'
import glob, xml.etree.ElementTree as ET
total, failed, skipped = 0, 0, 0
for f in glob.glob("test-results/**-junit.xml"):
    try:
        root = ET.parse(f).getroot()
        suites = [root] if root.tag == "testsuite" else root.findall("testsuite")
        for ts in suites:
            total   += int(ts.get("tests",    0))
            failed  += int(ts.get("failures", 0)) + int(ts.get("errors", 0))
            skipped += int(ts.get("skipped",  0))
    except Exception:
        pass
print("{},{},{}".format(total, failed, skipped))
EOF''',
        returnStdout: true
    ).trim()
    def parts        = counts.tokenize(',')
    def testsTotal   = parts[0].toInteger()
    def testsFailed  = parts[1].toInteger()
    def testsSkipped = parts[2].toInteger()
    def testsPassed  = testsTotal - testsFailed - testsSkipped

    def statusIcon = buildStatus == 'SUCCESS' ? '✅' : '❌'
    def subject    = "${statusIcon} [${buildStatus}] terraform-provider-nios – Build #${args.buildNumber} (${args.branch})"
    def body       = """
<html>
<body style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
  <h2>${statusIcon} Build <strong>${buildStatus}</strong>: terraform-provider-nios</h2>

  <table border="1" cellpadding="6" cellspacing="0"
         style="border-collapse: collapse; min-width: 480px;">
    <tr style="background: #f5f5f5;">
      <th align="left" style="padding: 6px 12px;">Field</th>
      <th align="left" style="padding: 6px 12px;">Value</th>
    </tr>
    <tr><td><b>Job</b></td><td>${env.JOB_NAME}</td></tr>
    <tr><td><b>Branch</b></td><td>${args.branch}</td></tr>
    <tr><td><b>Build #</b></td><td>${args.buildNumber}</td></tr>
    <tr><td><b>Duration</b></td><td>${args.duration}</td></tr>
    <tr><td><b>Tests Passed</b></td><td style="color: green;">${testsPassed}</td></tr>
    <tr><td><b>Tests Failed</b></td><td style="color: ${testsFailed > 0 ? 'red' : 'green'};">${testsFailed}</td></tr>
    <tr><td><b>Grid Master</b></td><td>${args.hostUrl}</td></tr>
    <tr><td><b>Grid Member</b></td><td>${args.memberUrl}</td></tr>
  </table>

  <br/>
  <p>
    📋 <a href="${args.buildUrl}testReport/">Full Test Report</a>
    &nbsp;|&nbsp;
    🖥️ <a href="${args.buildUrl}console">Console Output</a>
  </p>
</body>
</html>
"""
    // requestor() sends to the user who triggered this build — no explicit address needed
    emailext(
        subject            : subject,
        body               : body,
        mimeType           : 'text/html',
        recipientProviders : [requestor()]
    )
    echo 'Test-results email sent to the build invoker.'
}

def runLicenseSetup(String hostUrl, List<Integer> licenseNumbers, boolean disableStrictCaCertCheck = true) {
    sh """#!/usr/bin/env bash
        set -euo pipefail

        if ! command -v expect &> /dev/null; then
            echo "ERROR: 'expect' command not found. Please install expect." >&2
            exit 1
        fi

        export HOST_URL='${hostUrl}'
        export SSH_USER='admin'
        export CERT='/import/qaddi/qa-cloud-init-keypair.pem'
        export LICENSE_NUMBERS='${licenseNumbers.join(" ")}'
        export DISABLE_STRICT_CA_CERT_CHECK='${disableStrictCaCertCheck ? "1" : "0"}'

        echo "Connecting to \${SSH_USER}@\${HOST_URL} ..."
        echo ""
        echo "License numbers to activate: \${LICENSE_NUMBERS}"
        echo ""
        echo "──────────────────────────────────────"

        expect <<'EXPECT_SCRIPT'
set timeout 60
log_user 1

spawn ssh \
    -i "\$env(CERT)" \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR \
    "\$env(SSH_USER)@\$env(HOST_URL)"

expect {
    timeout { send_user "\\nERROR: Timeout waiting for prompt\\n"; exit 1 }
    eof { send_user "\\nERROR: Connection closed unexpectedly\\n"; exit 1 }
    -re {[>#] }
}

foreach lic_num [split \$env(LICENSE_NUMBERS) " "] {
    send_user "\\n→ Activating license \$lic_num\\n"
    send "set temp_license\\r"

    expect {
        timeout { send_user "\\nERROR: Timeout waiting for license selection prompt\\n"; exit 1 }
        "Select license" {
            send "\$lic_num\\r"
        }
    }

    while {1} {
        expect {
            timeout { break }
            -re {\\(y or n\\):} {
                send "y\\r"
            }
            -re {[>#] } {
                break
            }
        }
    }
}

if {\$env(DISABLE_STRICT_CA_CERT_CHECK) == "1"} {
    send_user "\\n→ Disabling strict CA cert check\\n"
    send "set disable_strict_ca_cert_check\\r"

    expect {
        timeout { }
        -re {\\(y or n\\):} {
            send "y\\r"
        }
    }

    expect -re {[>#] }
} else {
    send_user "\\n→ Skipping strict CA cert check disable\\n"
}

send "exit\\r"
expect eof
EXPECT_SCRIPT

        EXIT_CODE=\$?
        echo "──────────────────────────────────────"
        echo ""

        if [ \$EXIT_CODE -eq 0 ]; then
            echo "✅ License activation and CA cert check disable completed successfully for \${HOST_URL}"
        else
            echo "❌ Command execution failed with exit code \$EXIT_CODE" >&2
            exit \$EXIT_CODE
        fi
    """
}


// ── Main pipeline ─────────────────────────────────────────────────────────────
node('Cloud-test1-172.28.81.12-label') {
    timestamps {
        timeout(time: 240, unit: 'MINUTES') {

            // ── Environment variables ─────────────────────────────────────────
            env.NIOS_HOST_URL     = params.GM_URL
            env.NIOS_MEMBER_URL   = params.MEMBER_URL
            env.NIOS_DISCOVERY_MEMBER_URL = params.DISCOVERY_MEMBER_URL
            env.NIOS_WAPI_VERSION = 'v2.13.6'
            env.TF_ACC            = '1'
            env.TF_LOG            = params.ENABLE_DEBUG_LOGGING ? 'DEBUG' : ''
            env.GO_VERSION        = '1.25.3'
            env.TF_VERSION        = params.TF_VERSION
            env.PATH              = "${env.WORKSPACE}/tools/go/bin:/usr/local/go/bin:${env.HOME}/go/bin:${env.WORKSPACE}/bin:${env.PATH}"

            try {

                // ── Checkout ──────────────────────────────────────────────────
                stage('Checkout') {
                    git url: "https://github.com/${params.REPO_USER}/terraform-provider-nios.git", branch: params.BRANCH
                }

                // ── Install toolchain ─────────────────────────────────────────
                stage('Install toolchain') {
                    sh '''
                        # ── Go ───────────────────────────────────────────────
                        INSTALLED_GO=$(go version 2>/dev/null | awk '{print $3}' | sed 's/go//')

                        if [ "$INSTALLED_GO" = "$GO_VERSION" ]; then
                            echo "Go $GO_VERSION already installed, skipping."
                        else
                            echo "Installing Go $GO_VERSION (found: ${INSTALLED_GO:-none})..."
                            wget -q "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
                                -O /tmp/go.tar.gz

                            mkdir -p ${WORKSPACE}/tools
                            rm -rf ${WORKSPACE}/tools/go
                            tar -C ${WORKSPACE}/tools -xzf /tmp/go.tar.gz
                            rm /tmp/go.tar.gz

                            export PATH="${WORKSPACE}/tools/go/bin:${PATH}"
                            echo "Go installed: $(go version)"
                        fi

                        # ── Terraform ────────────────────────────────────────
                        INSTALLED_TF=$(terraform version 2>/dev/null | head -1 | awk '{print $2}' | sed 's/v//')

                        if [ "$INSTALLED_TF" = "$TF_VERSION" ]; then
                            echo "Terraform $TF_VERSION already installed, skipping."
                        else
                            echo "Installing Terraform $TF_VERSION (found: ${INSTALLED_TF:-none})..."
                            wget -q \
                                "https://releases.hashicorp.com/terraform/${TF_VERSION}/terraform_${TF_VERSION}_linux_amd64.zip" \
                                -O /tmp/terraform.zip

                            mkdir -p ${WORKSPACE}/bin
                            unzip -o /tmp/terraform.zip -d ${WORKSPACE}/bin/
                            rm /tmp/terraform.zip

                            echo "Terraform installed: $(${WORKSPACE}/bin/terraform version)"
                        fi

                        # ── go-junit-report ──────────────────────────────────
                        if ! command -v go-junit-report &> /dev/null; then
                            echo "Installing go-junit-report..."
                            go install github.com/jstemmer/go-junit-report/v2@latest
                        else
                            echo "go-junit-report already present."
                        fi
                    '''
                }

                // ── Setup credentials ─────────────────────────────────────────
                stage('Setup credentials') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'tf_automation',
                            usernameVariable: 'HOST_A_USER',
                            passwordVariable: 'HOST_A_PASS'
                        ),
                        usernamePassword(
                            credentialsId: 'tf_automation',
                            usernameVariable: 'HOST_B_USER',
                            passwordVariable: 'HOST_B_PASS'
                        )
                    ]) {
                        env.NIOS_USERNAME        = HOST_A_USER
                        env.NIOS_PASSWORD        = HOST_A_PASS
                        env.NIOS_MEMBER_USERNAME = HOST_B_USER
                        env.NIOS_MEMBER_PASSWORD = HOST_B_PASS
                    }
                    echo "Credentials loaded for ${env.NIOS_HOST_URL} and ${env.NIOS_MEMBER_URL}"
                }

                // ── Set licenses on Grid Master and Grid Member ───────────────────
                if (params.RUN_SET_LICENSE) {
                    stage('Set License (Grid Master)') {
                        def gmHost = params.GM_URL.replaceAll(/^https?:\/\//, '')
                        runLicenseSetup(gmHost, [8, 9, 11, 12, 13, 14, 15, 16])
                    }
                    stage('Set License (Grid Member)') {
                        def memberHost = params.MEMBER_URL.replaceAll(/^https?:\/\//, '')
                        runLicenseSetup(memberHost, [11, 12], false)
                    }
                } else {
                    echo 'Skipping: Set License (Grid Master + Grid Member)'
                }

                // ── Fetch ecosystem templates ─────────────────────────────────
                stage('Fetch ecosystem templates') {
                    sh '''#!/bin/bash
                        set -euo pipefail

                        DEST="${WORKSPACE}/internal/testdata/nios_ecosystem_templates"
                        mkdir -p "${DEST}"

                        QA_REPO="git@github.com:Infoblox-CTO/qa-nios-api-tests.git"
                        CACHE_DIR="${HOME}/.cache/qa-nios-api-tests-sparse"

                        if [ -d "${CACHE_DIR}/.git" ]; then
                            echo "Using cached repo at ${CACHE_DIR}, fetching latest..."
                            git -C "${CACHE_DIR}" fetch --depth=1 origin master
                            git -C "${CACHE_DIR}" checkout FETCH_HEAD
                        else
                            echo "No cache found, performing initial sparse clone..."
                            mkdir -p "${CACHE_DIR}"
                            git -C "${CACHE_DIR}" init -q
                            git -C "${CACHE_DIR}" remote add origin "${QA_REPO}"
                            git -C "${CACHE_DIR}" config core.sparseCheckout true
                            {
                                echo "WAPI_PyTest/suites/Outbound6_Cisco_ISE_Endpoint/Cisco_ISE_templates/"
                                echo "WAPI_PyTest/suites/Outbound5/Outbound5_templates/"
                                echo "fr/Core_DDI/regression/LRT/Security_Service_Provider/Security_Outbound-3/Event_templates/"
                            } > "${CACHE_DIR}/.git/info/sparse-checkout"
                            git -C "${CACHE_DIR}" fetch --depth=1 --filter=blob:none origin master \
                                2>/dev/null || git -C "${CACHE_DIR}" fetch --depth=1 origin master
                            git -C "${CACHE_DIR}" checkout FETCH_HEAD
                        fi

                        # Copy IPAM_PxgridEvent.json from Cisco ISE templates
                        ISE_SRC="${CACHE_DIR}/WAPI_PyTest/suites/Outbound6_Cisco_ISE_Endpoint/Cisco_ISE_templates"
                        cp "${ISE_SRC}/IPAM_PxgridEvent.json" "${DEST}/"
                        echo "Copied IPAM_PxgridEvent.json → ${DEST}/"

                        # Copy all files from Outbound5 templates
                        OB5_SRC="${CACHE_DIR}/WAPI_PyTest/suites/Outbound5/Outbound5_templates"
                        find "${OB5_SRC}" -maxdepth 1 -type f -exec cp {} "${DEST}/" \\;
                        echo "Copied all Outbound5 templates → ${DEST}/"

                        # Copy Security-Outbound3 event template
                        SEC_SRC="${CACHE_DIR}/fr/Core_DDI/regression/LRT/Security_Service_Provider/Security_Outbound-3/Event_templates/event_template_schema_default.json"
                        cp "${SEC_SRC}" "${DEST}/"
                        echo "Copied Security-Outbound3 event template → ${DEST}/"

                        echo "Ecosystem templates ready in ${DEST}:"
                        ls -1 "${DEST}"
                    '''
                }

                // ── Integration config ────────────────────────────────────────
                stage('Integration config') {
                    sh '''#!/bin/bash
                        set -euo pipefail

                        rm -f pipeline.env integration_test_setup.log
                        go run ./internal/testdata/integration_test_setup.go 2>&1 | tee integration_test_setup.log

                        if grep -E '(^|[[:space:]])Error( |:)' integration_test_setup.log >/dev/null; then
                            echo "integration_test_setup.go reported an error."
                            exit 1
                        fi

                        if [ ! -s pipeline.env ]; then
                            echo "pipeline.env was not generated or is empty."
                            exit 1
                        fi
                    '''

                    // Inject pipeline.env into Jenkins env
                    def envVars = readFile('pipeline.env').trim().split('\n')
                    envVars.each { line ->
                        def parts = line.split('=', 2)
                        if (parts.length == 2) {
                            env.setProperty(parts[0], parts[1])
                        }
                    }
                }

                // ── Test stages ───────────────────────────────────────────────
                sh 'rm -rf $WORKSPACE/test-results && mkdir -p $WORKSPACE/test-results'
                if (params.RUN_ACL)             { runTestStage('acl',             'internal/service/acl',             '5m')  } else { echo 'Skipping: acl' }
                if (params.RUN_CLOUD)           { runTestStage('cloud',           'internal/service/cloud',           '5m')  } else { echo 'Skipping: cloud' }
                if (params.RUN_DHCP)            { runTestStage('dhcp',            'internal/service/dhcp',            '80m') } else { echo 'Skipping: dhcp' }
                if (params.RUN_DISCOVERY)       { runTestStage('discovery',       'internal/service/discovery',       '10m') } else { echo 'Skipping: discovery' }
                if (params.RUN_DNS)             { runTestStage('dns',             'internal/service/dns',             '80m') } else { echo 'Skipping: dns' }
                if (params.RUN_DTC)             { runTestStage('dtc',             'internal/service/dtc',             '30m') } else { echo 'Skipping: dtc' }
                if (params.RUN_GRID)            { runTestStage('grid',            'internal/service/grid',            '30m') } else { echo 'Skipping: grid' }
                if (params.RUN_IPAM)            { runTestStage('ipam',            'internal/service/ipam',            '80m') } else { echo 'Skipping: ipam' }
                if (params.RUN_MICROSOFT)       { runTestStage('microsoft',       'internal/service/microsoft',       '30m') } else { echo 'Skipping: microsoft' }
                if (params.RUN_MISC)            { runTestStage('misc',            'internal/service/misc',            '30m') } else { echo 'Skipping: misc' }
                if (params.RUN_NOTIFICATION)    { runTestStage('notification',    'internal/service/notification',    '30m') } else { echo 'Skipping: notification' }
                if (params.RUN_PARENTALCONTROL) { runTestStage('parentalcontrol', 'internal/service/parentalcontrol', '30m') } else { echo 'Skipping: parentalcontrol' }
                if (params.RUN_RIR)             { runTestStage('rir',             'internal/service/rir',             '5m')  } else { echo 'Skipping: rir' }
                if (params.RUN_RPZ)             { runTestStage('rpz',             'internal/service/rpz',             '45m') } else { echo 'Skipping: rpz' }
                if (params.RUN_SECURITY)        { runTestStage('security',        'internal/service/security',        '30m') } else { echo 'Skipping: security' }
                if (params.RUN_SMARTFOLDER)     { runTestStage('smartfolder',     'internal/service/smartfolder',     '5m')  } else { echo 'Skipping: smartfolder' }

            } catch (err) {
                currentBuild.result = 'FAILURE'
                echo "Pipeline failed: ${err}"
                throw err
            } finally {
                // ── Post-build actions (always run) ───────────────────────────
                stage('Cleanup') {
                    echo 'Running cleanup...'
                    sh 'go run ./internal/testdata/integration_test_cleanup.go || true'
                }

                // Publish JUnit + archive logs
                junit allowEmptyResults: true, testResults: 'test-results/**-junit.xml'
                archiveArtifacts artifacts: 'test-results/*.txt', allowEmptyArchive: true

                if (currentBuild.result == 'FAILURE') {
                    echo """
                    ❌ One or more tests failed. Check the Test Results tab above.
                    Grid Master: ${env.NIOS_HOST_URL}
                    Grid Member: ${env.NIOS_MEMBER_URL}
                    """
                } else {
                    echo """
                    ✅ All tests passed.
                    Grid Master: ${env.NIOS_HOST_URL}
                    Grid Member: ${env.NIOS_MEMBER_URL}
                    """
                }

                // ── Email notification ────────────────────────────────────
                stage('Email Results') {
                    sendTestResultsMail(
                        buildStatus  : currentBuild.result ?: 'SUCCESS',
                        branch       : params.BRANCH,
                        buildNumber  : env.BUILD_NUMBER,
                        duration     : currentBuild.durationString,
                        buildUrl     : env.BUILD_URL,
                        hostUrl      : env.NIOS_HOST_URL,
                        memberUrl    : env.NIOS_MEMBER_URL
                    )
                }
            }

        } // timeout
    } // timestamps
} // node